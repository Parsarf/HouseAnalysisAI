[importlinter]
root_packages =
    api
    analyst
    auth
    calibration
    changes
    chat
    classification
    common
    contracts
    db
    exports
    extraction
    finance
    flags
    identity
    ingestion
    jobs
    normalization
    ops
    outreach
    pipeline
    scoring
    strategies

[importlinter:contracts]
name = Contracts are dependency-free
type = forbidden
source_modules =
    contracts
forbidden_modules =
    api
    chat
    ingestion
    classification
    identity
    extraction
    normalization
    finance
    strategies
    scoring
    flags
    pipeline
    outreach

[importlinter:layers]
name = Layered package dependencies
type = layers
layers =
    api
    chat: outreach
    pipeline
    ingestion: classification: identity: extraction: normalization: finance: strategies: scoring: flags: exports: changes: calibration: ops
    common
    contracts
